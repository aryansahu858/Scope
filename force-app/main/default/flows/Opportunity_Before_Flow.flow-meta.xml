    <formulas>
        <name>addCurrentCLV_IndtoParentCLV_Ind</name>
        <dataType>Currency</dataType>
        <expression>{!$Record.Account_Name__r.CLV_Individual__c} + {!storeChildOppCLV_IndAmount}</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>isCloseDateIsInFY</name>
        <dataType>Boolean</dataType>
        <expression>AND(
{!$Record.Close_Date__c} &gt;= DATE(YEAR(TODAY()) - IF(MONTH(TODAY()) &lt; 4, 1, 0), 4, 1),
{!$Record.Close_Date__c} &lt;= DATE(YEAR(TODAY()) + IF(MONTH(TODAY()) &gt;= 4, 1, 0), 3, 31)
)</expression>
    </formulas>
    <formulas>
        <name>totalCLV</name>
        <dataType>Currency</dataType>
        <expression>{!$Record.Account_Name__r.Customer_Lifetime_Value__c} + {!parentTotalCLV}</expression>
        <scale>2</scale>
    </formulas>
