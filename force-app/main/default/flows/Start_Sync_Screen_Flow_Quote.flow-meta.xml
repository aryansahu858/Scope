            <isGoTo>true</isGoTo>
            <targetReference>Fault_Path_Quote_Record</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Opportunity_Name__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId.Opportunity_Name__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>Is_Primary__c</field>
